# ─── API (set one of the two) ─────────────────────────────────────────────────
# OpenRouter — https://openrouter.ai/keys — use with Claude via MODEL_ID (e.g. anthropic/...)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Or OpenAI directly (sk-...). If set, OpenRouter is ignored.
# OPENAI_API_KEY=sk-...

# ─── Main model ──────────────────────────────────────────────────────────────
# OpenRouter: e.g. anthropic/claude-opus-4. OpenAI: e.g. gpt-4o
MODEL_ID=anthropic/claude-opus-4

# ─── Timing ──────────────────────────────────────────────────────────────────
# Seconds between inquiry cycles (default: 3600 = 1 hour)
CYCLE_INTERVAL_SECONDS=3600
# Optional: run one cycle per day at this time (UTC). Example: 07:30. If unset, cycle every CYCLE_INTERVAL_SECONDS from startup.
# CYCLE_DAILY_AT_UTC=07:30

# ─── Data ───────────────────────────────────────────────────────────────────
# Directory for state, manuscript, tensions, commitments, archive (default: ./data)
DATA_DIR=./data

# VPS sync (for scripts/sync_from_vps.sh — pull data for local testing)
# VPS_HOST=user@meaning-seeker.com
# VPS_DATA_PATH=/home/user/meaning-seeker.com/data

# ─── Site (OpenRouter headers; ignored when using OpenAI) ─────────────────────
SITE_URL=https://meaning-seeker.com
SITE_NAME=Meaning Seeker

# ─── API call behaviour ──────────────────────────────────────────────────────
# Timeout in seconds for the main model request (default: 180)
API_TIMEOUT_SECONDS=180

# ─── Phase B: Monitoring ─────────────────────────────────────────────────────
# Lightweight model for repetition, substance, summary, threat mapping (same API as main)
MONITOR_MODEL_ID=anthropic/claude-3.5-haiku

# ─── Phase B: Archive retrieval (Ollama) ──────────────────────────────────────
# Base URL for Ollama (default: http://localhost:11434). Install Ollama and run: ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
# Embedding model name (default: nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Phase C: Web server ──────────────────────────────────────────────────────
# Host and port for the web server. Default: 127.0.0.1:3000 (bind locally when behind Caddy)
# WEB_HOST=127.0.0.1
# WEB_PORT=3000

# CSRF secret for submission form (required in production; set to a random string)
# CSRF_SECRET=your-random-secret-here

# Admin dashboard (password-protected at /admin)
# ADMIN_PASSWORD=your-secure-password
# ADMIN_SALT=random-string-for-session-signing

# ─── Phase C: Image generation (OpenRouter FLUX) ─────────────────────────────
# Uses the same OPENROUTER_API_KEY — no separate key needed.
# Switch the model here to use a different FLUX variant.
# IMAGE_MODEL=black-forest-labs/flux.2-klein-4b

# ─── Phase C: Social media ────────────────────────────────────────────────────
# X (Twitter) — requires Elevated access
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
# X_BEARER_TOKEN=

# Bluesky
# BLUESKY_HANDLE=yourhandle.bsky.social
# BLUESKY_PASSWORD=your_app_password

# Threads / Instagram (Meta Graph API)
# THREADS_ACCESS_TOKEN=
# THREADS_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=

# Public profile URLs (for follow links on challenge page)
# X_PROFILE_URL=https://x.com/yourhandle
# BLUESKY_PROFILE_URL=https://bsky.app/profile/yourhandle.bsky.social
# THREADS_PROFILE_URL=https://www.threads.net/@yourhandle
# INSTAGRAM_PROFILE_URL=https://www.instagram.com/yourhandle

# ─── Phase C: Filtering ───────────────────────────────────────────────────────
# Model for filtering pipeline (defaults to MONITOR_MODEL_ID)
# FILTER_MODEL_ID=anthropic/claude-3.5-haiku

# Disable social moderation (not recommended)
# SOCIAL_MODERATION_ENABLED=true

# Force image generation (for testing)
# FORCE_IMAGE=true
# Force Sunday weekly review this cycle (for testing). Run: FORCE_WEEKLY_REVIEW=1 .venv/bin/python main.py --once
# FORCE_WEEKLY_REVIEW=true
